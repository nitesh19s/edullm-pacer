# Server
NODE_ENV=development
PORT=3000

# Database (absolute path to SQLite file)
DB_PATH=/path/to/edullm-database.db

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=ncert-edu
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=120000

# Frontend (served as static files)
FRONTEND_DIR=/path/to/frontend

# Features
ENABLE_ANALYTICS=true
ENABLE_EXPERIMENTS=true
ENABLE_RESEARCH_FEATURES=true

# API Key (leave blank in dev — auth disabled when NODE_ENV=development and API_KEY unset)
# API_KEY=your-secret-key-here

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# Rate limiting (requests per 15 min window per IP)
RATE_LIMIT=10000
